# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database (Postgres) ---
DATABASE_URL=postgresql://refmaster:refmaster@localhost:5432/refmaster?schema=public

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_HEAVY=gpt-4o

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# --- hCaptcha (optional) ---
HCAPTCHA_SECRET=

# --- Storage ---
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated

# --- Limits ---
FREE_PLAN_PAGE_LIMIT=10
FREE_PLAN_MONTHLY_LIMIT=3
PREMIUM_PLAN_PAGE_LIMIT=60
PREMIUM_PLAN_MONTHLY_LIMIT=200

# --- Sources APIs ---
SEMANTIC_SCHOLAR_API_KEY=
